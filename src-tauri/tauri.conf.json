{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IYAGI Layout",
  "version": "0.1.3",
  "identifier": "ai.iyagi.layout",
  "build": {
    "beforeDevCommand": "npm run build:icon-assets && npm run dev:frontend",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build:icon-assets && npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "license": "Apache-2.0",
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "files": {
        "Resources/Assets.car": "icons/build/Assets.car"
      }
    }
  },
  "plugins": {}
}
